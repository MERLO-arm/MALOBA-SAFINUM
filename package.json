{
  "name": "maloba-safinum",
  "version": "1.0.0",
  "description": "Maloba AnyDoc — Multimodal digital financial accessibility browser extension (MV3) for Cameroonian national languages (SAFINUM Innovate Challenge 2026).",
  "scripts": {
    "build:css": "tailwindcss -i safinum-extension/popup/popup.input.css -o safinum-extension/popup/popup.css --minify",
    "watch:css": "tailwindcss -i safinum-extension/popup/popup.input.css -o safinum-extension/popup/popup.css --watch",
    "build:kb": "python3 scripts/build_dataset_kb.py",
    "build:numbers": "python3 scripts/build_eton_real_number_audio.py",
    "package": "python3 scripts/package_extension.py",
    "test": "node tests/verify_extension.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MERLO-arm/MALOBA-SAFINUM.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MERLO-arm/MALOBA-SAFINUM/issues"
  },
  "homepage": "https://github.com/MERLO-arm/MALOBA-SAFINUM#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
