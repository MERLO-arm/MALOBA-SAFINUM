{
  "manifest_version": 3,
  "name": "Maloba AnyDoc — Accessibilité Financière Cameroun (Éton & N-Langues)",
  "short_name": "Maloba AnyDoc",
  "version": "2.0.0",
  "description": "Extension d'accessibilité financière multimodale aux couleurs de Maloba (Traduction DOM vérifiée & audio humain réel .webm en Éton eto, Architecture extensible N-langues) pour le SAFINUM Innovate Challenge 2026.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://safinum.cm/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Maloba AnyDoc (Éton · Cameroun)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/logo_maloba.png",
        "icons/maloba_logo.svg",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "assets/audio/eton/*.webm",
        "assets/audio/eto/*.ogg"
      ],
      "matches": [
        "https://safinum.cm/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://safinum.cm/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "js": [
        "src/core/knowledge_base.js",
        "src/core/context_graph.js",
        "src/numbers/numberDecomposer.js",
        "src/numbers/audioStitcherPlayer.js",
        "src/numbers/safinumEngine.js",
        "src/core/voice_engine.js",
        "src/services/screenReaderService.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
