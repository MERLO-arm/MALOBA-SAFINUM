{
  "manifest_version": 3,
  "name": "Maloba AnyDoc — Accessibilité Financière Cameroun (Fulfuldé & Ewondo)",
  "short_name": "Maloba AnyDoc",
  "version": "1.1.0",
  "description": "Extension d'accessibilité financière multimodale aux couleurs de Maloba (Traduction DOM multilingue Fulfuldé fub & Ewondo ewo, Architecture extensible N-langues, Graphe de Contexte 5-Nœuds, Lecture vocale et Explication pédagogique AnyDoc) pour le SAFINUM Innovate Challenge 2026.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://safinum.cm/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Maloba AnyDoc (Fulfuldé & Ewondo · Cameroun)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/logo_maloba.png",
        "icons/maloba_logo.svg",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://safinum.cm/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://safinum.cm/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "knowledge_base.js",
        "context_graph.js",
        "voice_engine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
